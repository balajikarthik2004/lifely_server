# ---------------------------------------------------------------------------
# Lifely API
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Replace <password> with the real one and
# put the database name in the path, as below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lifely?retryWrites=true&w=majority

# Secrets. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list, or * to allow any origin (development only).
CORS_ORIGINS=*

# Requests per window, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
